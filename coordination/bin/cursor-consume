#!/usr/bin/env bash
# Cursor app-seat front door for one separately approved cursor advance.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

# Pin the repo venv and prove it can run the front door, matching cursor-seat
# / send-event. The previous ambient `python3` could be a 3.9 that dies on
# `list[str]` / `X | Y` typing or pick up a shadowed PYTHONPATH.
PYTHON="$ROOT/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  PYTHON=$(command -v python3 || true)
fi
if [ -z "$PYTHON" ]; then
  echo "cursor-consume: no python3 found in $ROOT/.venv/bin or on PATH" >&2
  exit 2
fi
if ! "$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
  echo "cursor-consume: $PYTHON ($("$PYTHON" -V 2>&1)) cannot run this front door; needs 3.11+" >&2
  exit 2
fi

exec "$PYTHON" "$ROOT/scripts/cursor_mailbox.py" consume "$@"
