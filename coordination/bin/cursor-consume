#!/usr/bin/env bash
# Interactive, seat-bound front door for consuming one seat's mailbox cursor.
# Delegates to the fixed consume-events writer; never reimplements it.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
exec /usr/bin/env -u GIT_INDEX_FILE python3 "$ROOT/scripts/cursor_mailbox.py" consume "$@"
