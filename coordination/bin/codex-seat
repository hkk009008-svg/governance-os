#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)

# Prefer the repo venv, and prove whatever we land on can actually run the
# launcher. It previously exec'd an ambient interpreter resolved from the
# caller's PATH -- the venv normally, macOS system 3.9.6 stripped, where
# the `tomllib` this launcher imports does not exist and the seat died on a
# ModuleNotFoundError instead of its own error contract.
#
# Read the limit honestly: when no venv exists this still selects from PATH, and
# a probe run by that same interpreter cannot establish where it came from. This
# is a *capability* check, not a provenance control -- it answers "can this
# thing run the launcher", not "is this thing trustworthy". An absolute pin
# would answer neither for CI, which provisions Python via actions/setup-python
# and never creates .venv.
#
# So the probe imports what the launcher imports rather than asking for a
# version number: an interpreter that reports 3.11 but cannot import `tomllib`
# -- a shadowing PYTHONPATH, a broken install -- is refused here rather than
# tracebacking later. Exit 2 matches the launcher's own refusal code.
PYTHON="$ROOT/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  PYTHON=$(command -v python3 || true)
fi
if [ -z "$PYTHON" ]; then
  echo "codex-seat: no python3 found in $ROOT/.venv/bin or on PATH" >&2
  exit 2
fi
if ! "$PYTHON" -c 'import sys, tomllib; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
  echo "codex-seat: $PYTHON ($("$PYTHON" -V 2>&1)) cannot run this launcher; needs 3.11+ and an importable tomllib" >&2
  exit 2
fi

exec "$PYTHON" "$ROOT/pipeline/codex_seat_launcher.py" "$@"
