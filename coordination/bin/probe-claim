#!/bin/bash
# probe-claim — one claim in, its premises and an amnesiac's attack out.
#
# The premises come from the claim's shape (claim_check.py grammar), so the
# author does not have to remember them. The probe goes to a cross-family
# reader whose prompt carries only the claim and whose launch is
# reduced-context — empty cwd, minimal env, lane config skipped; HOME and the
# binary path remain pointers, and claim_check.py says so. The point survives
# the caveat: every one of the nine 2026-07-26/27 failures was visible to a
# cold reader holding nothing but the sentence. Advisory on both counts; this
# gates nothing, substitutes for no review, and each run is a provider launch
# whose spend needs its own authority.
set -euo pipefail

if [ $# -lt 1 ] || [ -z "${1:-}" ]; then
  echo "usage: probe-claim \"<one load-bearing claim sentence>\"" >&2
  exit 2
fi

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
PYTHON="$ROOT/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  PYTHON=$(command -v python3 || true)
fi
if [ -z "$PYTHON" ]; then
  echo "probe-claim: no python3 found in $ROOT/.venv/bin or on PATH" >&2
  exit 2
fi

echo "== premises (from claim shape, not memory) =="
env -u GIT_INDEX_FILE "$PYTHON" "$ROOT/scripts/claim_check.py" premises "$1"
echo
echo "== amnesiac probe (cross-family, reduced-context) =="
env -u GIT_INDEX_FILE "$PYTHON" "$ROOT/scripts/claim_check.py" probe --execute "$1"
