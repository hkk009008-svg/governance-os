#!/bin/bash
# probe-claim — one claim in, its premises and an amnesiac prompt out.
#
# The premises come from the claim's shape (claim_check.py grammar), so the
# author does not have to remember them. The second section is text for a
# native same-family desktop subagent given only the claim sentence. This
# script starts no model, sends no team message, grants no authority, and
# substitutes for no independent review.
set -euo pipefail

if [ $# -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  echo 'usage: bin/pipeline probe "<one load-bearing claim sentence>"'
  echo "Print local premises and a prompt for a native reduced-context subagent."
  echo "Starts no model and sends no team message."
  exit 0
fi

if [ $# -ne 1 ] || [ -z "${1:-}" ] || [ "$1" = "--execute" ]; then
  echo "usage: probe-claim \"<one load-bearing claim sentence>\"" >&2
  exit 2
fi

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
PYTHON="$ROOT/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  PYTHON=$(command -v python3 || true)
fi
if [ -z "$PYTHON" ]; then
  echo "probe-claim: no python3 found in $ROOT/.venv/bin or on PATH" >&2
  exit 2
fi

echo "== premises (from claim shape, not memory) =="
env -u GIT_INDEX_FILE "$PYTHON" "$ROOT/pipeline/claim_check.py" premises "$1"
echo
echo "== prompt for a native reduced-context subagent (not executed) =="
env -u GIT_INDEX_FILE "$PYTHON" "$ROOT/pipeline/claim_check.py" probe "$1"
