#!/usr/bin/env bash
# coordination/bin/release-lock <wave> <module> <seat>
# Delete a held lock only for its recorded holder.
set -euo pipefail
[ $# -eq 3 ] || { echo "usage: release-lock <wave> <module> <seat>" >&2; exit 2; }
wave="$1"; module="$2"; seat="$3"

safe_atom() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && [[ "$1" != "." && "$1" != ".." ]]
}
safe_module() {
  [[ "$1" != /* && "$1" != */ && "$1" != *//* ]] || return 1
  local segment
  local -a segments
  IFS='/' read -r -a segments <<< "$1"
  for segment in "${segments[@]}"; do safe_atom "$segment" || return 1; done
}
encode_module() {
  local input="$1" encoded="" byte i
  LC_ALL=C
  for ((i = 0; i < ${#input}; i++)); do
    printf -v byte '%02x' "'${input:i:1}"
    encoded+="$byte"
  done
  printf 'm-%s' "$encoded"
}

safe_atom "$wave" || { echo "invalid wave identifier" >&2; exit 2; }
safe_module "$module" || { echo "invalid module path" >&2; exit 2; }
safe_atom "$seat" || { echo "invalid seat identifier" >&2; exit 2; }

# Ambient GIT_* variables can retarget which repository/index the release
# commit lands in. Strip the repo-retargeting set (mirror of
# scripts/git_runner.py REPO_RETARGETING_GIT_VARS) while preserving the
# credential/config environment the push needs.
for retarget_var in GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES \
  GIT_COMMON_DIR GIT_DIR GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_INDEX_FILE \
  GIT_NAMESPACE GIT_OBJECT_DIRECTORY GIT_WORK_TREE; do
  unset "$retarget_var"
done

cd "$(git rev-parse --show-toplevel)"
branch="$(git symbolic-ref --quiet --short HEAD)" \
  || { echo "release-lock requires an attached branch" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=normal)" ] \
  || { echo "release-lock requires a clean worktree and index" >&2; exit 1; }
flat="$(encode_module "$module")"
lock="coordination/locks/${wave}-${flat}.lock"
remote_ref="refs/remotes/origin/${branch}"
git fetch -q origin "refs/heads/${branch}:${remote_ref}" \
  || { echo "release-lock could not refresh origin/${branch}" >&2; exit 1; }
git merge -q --ff-only "$remote_ref" \
  || { echo "release-lock requires a fast-forwardable origin/${branch}" >&2; exit 1; }
remote_head="$(git rev-parse "$remote_ref")"
[ "$(git rev-parse HEAD)" = "$remote_head" ] \
  || { echo "release-lock requires local HEAD to exactly match origin/${branch}; reconcile UNKNOWN or local-only commits separately" >&2; exit 1; }
[ ! -L "$lock" ] || { echo "malformed lock record: $lock is a symlink" >&2; exit 1; }
[ -e "$lock" ] || { echo "no such lock: $lock" >&2; exit 0; }
[ -f "$lock" ] || { echo "malformed lock record: $lock is not a regular file" >&2; exit 1; }
read -r holder held_wave _ held_defect held_module extra < "$lock" \
  || { echo "malformed lock record: $lock" >&2; exit 1; }
[ -z "${extra:-}" ] && [ "$held_wave" = "$wave" ] && [ "$held_module" = "$module" ] \
  && safe_atom "$holder" && safe_atom "$held_defect" && safe_module "$held_module" \
  || { echo "malformed lock record: $lock" >&2; exit 1; }
[ "$holder" = "$seat" ] \
  || { echo "refusing release: $lock is held by $holder, not $seat" >&2; exit 1; }
base_head="$(git rev-parse HEAD)"
if ! git rm -q -- "$lock" || ! git commit -q -m "unlock(${wave}): ${module}" -- "$lock"; then
  git restore -q --source=HEAD --staged --worktree -- "$lock" 2>/dev/null || true
  echo "release-lock could not create its unlock commit" >&2
  exit 1
fi
release_commit="$(git rev-parse HEAD)"
# A nonzero transport result is not proof that the remote rejected the update:
# the server may have accepted it before the acknowledgement was lost. Refresh
# the exact branch and prove ancestry before restoring the local lock.
if ! git push -q origin "HEAD:${branch}"; then
  if ! git fetch -q origin "refs/heads/${branch}:${remote_ref}"; then
    echo "UNKNOWN: release push returned nonzero and origin/${branch} could not be inspected; preserve this clean release commit and reconcile before retrying" >&2
    exit 3
  fi
  if git merge-base --is-ancestor "$release_commit" "$remote_ref"; then
    echo "RELEASED: $lock (remote accepted; push acknowledgement was lost)"
    exit 0
  fi
  if [ "$(git rev-parse HEAD)" = "$release_commit" ]; then
    git reset -q --soft "$base_head"
    git restore -q --source=HEAD --staged --worktree -- "$lock"
  fi
  echo "RELEASE NOT APPLIED: $lock remains held on origin" >&2
  exit 1
fi
echo "RELEASED: $lock"
