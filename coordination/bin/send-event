#!/bin/bash -p
PATH=/usr/bin:/bin
export PATH
# send-event — compose one mailbox event and hand every kind to the fixed writer.
set -euo pipefail

TMP=""
PUBLISHED_OUT=""
GIT_ENV_ROOT=""

cleanup_partial() {
  cleanup_status=$?
  trap - EXIT
  [ -z "$TMP" ] || /bin/rm -f -- "$TMP"
  [ -z "$PUBLISHED_OUT" ] || /bin/rm -f -- "$PUBLISHED_OUT"
  [ -z "$GIT_ENV_ROOT" ] || /bin/rm -rf -- "$GIT_ENV_ROOT"
  exit "$cleanup_status"
}
trap cleanup_partial EXIT

while IFS='=' read -r inherited_name inherited_value; do
  case "$inherited_name" in
    GIT_*) unset "$inherited_name" ;;
  esac
done < <(/usr/bin/env)

GIT_ENV_ROOT=$(/usr/bin/mktemp -d /tmp/send-event-git.XXXXXX)
/bin/chmod 0700 "$GIT_ENV_ROOT"
/bin/mkdir -m 0700 "$GIT_ENV_ROOT/home" "$GIT_ENV_ROOT/xdg"

git_clean() {
  /usr/bin/env -i \
    PATH=/usr/bin:/bin LANG=C LC_ALL=C \
    HOME="$GIT_ENV_ROOT/home" XDG_CONFIG_HOME="$GIT_ENV_ROOT/xdg" \
    /usr/bin/env -u GIT_INDEX_FILE \
    /usr/bin/git --no-replace-objects --literal-pathspecs "$@"
}

usage() { echo "usage: send-event <from> <to> <kind> <subject...>  (body on stdin)"; }

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

[ $# -ge 4 ] || { usage >&2; exit 2; }
FROM=$1
TO=$2
KIND=$3
shift 3
SUBJECT="$*"

case "$FROM" in
  director|director2|operator|operator2|coordinator|coordinator2) ;;
  *)
    echo "send-event: bad <from>: $FROM (director|director2|operator|operator2|coordinator|coordinator2)" >&2
    exit 2
    ;;
esac
case "$TO" in
  director|director2|operator|operator2|coordinator|coordinator2|all) ;;
  *)
    echo "send-event: bad <to>: $TO (director|director2|operator|operator2|coordinator|coordinator2|all)" >&2
    exit 2
    ;;
esac
[ "$FROM" != "$TO" ] || { echo "send-event: refusing self-addressed event" >&2; exit 2; }

ROOT=$(git_clean rev-parse --show-toplevel)
COMMON=$(git_clean -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)
PRIMARY_ROOT=$(/usr/bin/dirname "$COMMON")
TRUSTED_PYTHON="$PRIMARY_ROOT/.venv/bin/python"
SCRIPT_DIR=$(/usr/bin/dirname "${BASH_SOURCE[0]:-$0}")
TOOL_ROOT=$(cd "$SCRIPT_DIR/../.." && /bin/pwd -P)
MAILBOX_WRITER="$TOOL_ROOT/scripts/mailbox_writer.py"
COMPACT_VALIDATOR="$TOOL_ROOT/scripts/compact_pair_loop.py"
if [ ! -x "$TRUSTED_PYTHON" ]; then
  echo "send-event: trusted Pipeline Python unavailable" >&2
  exit 4
fi
if [ ! -f "$MAILBOX_WRITER" ]; then
  echo "send-event: trusted Pipeline mailbox writer unavailable" >&2
  exit 4
fi
if [ ! -f "$COMPACT_VALIDATOR" ]; then
  echo "send-event: trusted compact-pair validator unavailable" >&2
  exit 4
fi

KIND_FILE="$ROOT/coordination/mailbox/kinds.txt"
if [ ! -f "$KIND_FILE" ]; then
  echo "send-event: missing mailbox kind registry: $KIND_FILE" >&2
  exit 2
fi
if ! /usr/bin/grep -Fxq -- "$KIND" "$KIND_FILE"; then
  echo "send-event: unknown kind '$KIND' (see $KIND_FILE)" >&2
  exit 2
fi
if [ "$KIND" = "verification-report" ]; then
  case "$FROM" in
    operator|operator2) ;;
    *)
      echo "send-event: only operator seats may publish verification-report" >&2
      exit 2
      ;;
  esac
fi

TS_DASH=$(/bin/date -u +%Y-%m-%dT%H-%M-%SZ)
TS_COLON="${TS_DASH:0:11}$(printf '%s' "${TS_DASH:11:8}" | /usr/bin/tr '-' ':')Z"
REL="coordination/mailbox/sent/$TS_DASH-$FROM-to-$TO-$KIND.md"
FROM_TITLE="$(printf '%s' "${FROM:0:1}" | /usr/bin/tr '[:lower:]' '[:upper:]')${FROM:1}"
TO_TITLE="$(printf '%s' "${TO:0:1}" | /usr/bin/tr '[:lower:]' '[:upper:]')${TO:1}"
CURSOR=$(/usr/bin/head -1 "$ROOT/coordination/mailbox/seen/$FROM.txt" 2>/dev/null || echo "unknown")
BODY=$(/bin/cat)

TMP=$(/usr/bin/mktemp "$ROOT/coordination/mailbox/sent/.${TS_DASH}-${FROM}-to-${TO}-${KIND}.XXXXXX.tmp")
{
  printf '# %s → %s: %s\n\n' "$FROM_TITLE" "$TO_TITLE" "$SUBJECT"
  printf '**When:** %s · **From:** %s (online)\n\n' "$TS_COLON" "$FROM"
  if [ -n "$BODY" ]; then
    printf '%s\n\n' "$BODY"
  fi
  printf 'Cursor at send: %s\n' "$CURSOR"
} > "$TMP"
/bin/chmod 0600 "$TMP"

if [ "$KIND" = "verification-report" ]; then
  /usr/bin/env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C \
    HOME="$GIT_ENV_ROOT/home" XDG_CONFIG_HOME="$GIT_ENV_ROOT/xdg" \
    "$TRUSTED_PYTHON" -E -s -S -B "$COMPACT_VALIDATOR" \
    validate-candidate --repo-root "$ROOT" --candidate "$TMP" --final-relative "$REL"
fi

PUBLISHED_OUT=$(/usr/bin/mktemp "$ROOT/coordination/mailbox/sent/.published.XXXXXX.tmp")
/bin/chmod 0600 "$PUBLISHED_OUT"
/usr/bin/env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C \
  "$TRUSTED_PYTHON" -E -s -S -B "$MAILBOX_WRITER" \
  send-event-finalize --repo-root "$ROOT" --candidate "$TMP" --final-relative "$REL" \
  > "$PUBLISHED_OUT"
RESULT=$(LC_ALL=C /usr/bin/sed -n '1p' "$PUBLISHED_OUT")
case "$RESULT" in
  staged:"$REL") ;;
  unstaged:"$REL")
    TMP=""
    echo "send-event: git add failed; kept $REL (not staged; commit with explicit pathspec)" >&2
    echo "created $REL (not staged; git add failed)"
    exit 0
    ;;
  *)
    echo "send-event: finalizer output is invalid" >&2
    exit 4
    ;;
esac
TMP=""
echo "created $REL (staged; commit with explicit pathspec)"
