#!/bin/sh
set -eu

connector_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
connector_python=""

if [ -x "$connector_root/.venv/bin/python" ]; then
    connector_python="$connector_root/.venv/bin/python"
else
    connector_common_dir=$(git -C "$connector_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    connector_primary_root=$(dirname -- "$connector_common_dir")
    if [ -n "$connector_common_dir" ] && [ -x "$connector_primary_root/.venv/bin/python" ]; then
        connector_python="$connector_primary_root/.venv/bin/python"
    else
        connector_python=$(command -v python3 || true)
    fi
fi

if [ -z "$connector_python" ]; then
    echo "no Python 3 runtime found for the Claude task connector" >&2
    exit 2
fi

exec "$connector_python" "$connector_root/scripts/claude_task_connector.py" "$@"
