#!/bin/bash -p
# Fixed shim for the v1 mailbox cursor writer. The trusted Python operation
# owns argument validation, selector fencing, durable replacement, and staging.
set -euo pipefail

ROOT=$(
  /usr/bin/env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C \
    /usr/bin/git --no-replace-objects --literal-pathspecs rev-parse --show-toplevel
)
COMMON=$(
  /usr/bin/env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C \
    /usr/bin/git --no-replace-objects --literal-pathspecs -C "$ROOT" \
      rev-parse --path-format=absolute --git-common-dir
)
PRIMARY_ROOT=$(/usr/bin/dirname "$COMMON")
TRUSTED_PYTHON="$PRIMARY_ROOT/.venv/bin/python"
SCRIPT_DIR=$(/usr/bin/dirname "${BASH_SOURCE[0]:-$0}")
TOOL_ROOT=$(cd "$SCRIPT_DIR/../.." && /bin/pwd -P)
KERNEL_FINALIZER="$TOOL_ROOT/scripts/kernel_activation.py"

if [ ! -x "$TRUSTED_PYTHON" ] || [ ! -f "$KERNEL_FINALIZER" ]; then
  echo "consume-events: trusted Pipeline finalizer unavailable" >&2
  exit 4
fi

exec /usr/bin/env -i PATH=/usr/bin:/bin LANG=C LC_ALL=C \
  "$TRUSTED_PYTHON" -E -s -S -B "$KERNEL_FINALIZER" \
  consume-events "$@" --repo-root "$ROOT"
