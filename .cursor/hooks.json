{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/seat-policy --event sessionStart",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/seat-policy --event preToolUse",
        "matcher": "Write|Delete|Edit|ApplyPatch",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/seat-policy --event beforeShellExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/seat-policy --event beforeMCPExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/seat-policy --event subagentStart",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
