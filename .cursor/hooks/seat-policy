#!/usr/bin/env bash
# Fail-closed wrapper for the Cursor Desktop app-seat policy.
#
# Failure semantics: the four permission events (preToolUse,
# beforeShellExecution, beforeMCPExecution, subagentStart) are failClosed in
# .cursor/hooks.json, and this wrapper additionally emits an explicit deny so
# a crashed policy can never read as approval. sessionStart is deliberately
# NOT failClosed — a broken hook must not block every session — so failure
# output carries additional_context making the degraded, unbound start
# visible in-chat instead of silent. Policy stderr from the most recent run
# is preserved at .cursor/runtime/hook-policy-stderr.log for diagnosis.
set -uo pipefail

fail() {
  # Emit one JSON object that serves both event families: permission fields
  # for the enforceable events, additional_context for sessionStart. The
  # message is JSON-sanitized by deleting the only dangerous bytes; this
  # wrapper cannot assume python exists at this point.
  reason=$(printf '%s' "$1" | tr -d '"\\\n\t')
  printf '{"permission":"deny","user_message":"%s","agent_message":"%s","additional_context":"Pipeline Cursor posture: readiness-bridge (degraded). %s"}\n' \
    "$reason" "$reason" "$reason"
  exit 0
}

ROOT=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd) \
  || fail "Cursor seat hook could not resolve the Pipeline root."

PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=$(command -v python3 || true)
[ -n "$PY" ] || fail "Cursor seat hook found no Python interpreter."

POLICY="$ROOT/scripts/cursor_hook_policy.py"
[ -f "$POLICY" ] || fail "Cursor seat hook policy script is missing."

STDERR_LOG="$ROOT/.cursor/runtime/hook-policy-stderr.log"
mkdir -p "$ROOT/.cursor/runtime" 2>/dev/null || STDERR_LOG=/dev/null

POLICY_OUTPUT=""
if ! POLICY_OUTPUT=$("$PY" "$POLICY" "$@" 2>"$STDERR_LOG"); then
  fail "Cursor seat hook policy failed to execute; see .cursor/runtime/hook-policy-stderr.log."
fi
if ! printf '%s' "$POLICY_OUTPUT" | "$PY" -c '
import json
import sys

payload = json.load(sys.stdin)
if not isinstance(payload, dict):
    raise ValueError("hook output must be a JSON object")
permission = payload.get("permission")
if permission is not None and permission not in {"allow", "ask", "deny"}:
    raise ValueError("hook output permission must be allow, ask, or deny")
' 2>>"$STDERR_LOG"; then
  fail "Cursor seat hook policy emitted invalid JSON; see .cursor/runtime/hook-policy-stderr.log."
fi

printf '%s\n' "$POLICY_OUTPUT"
