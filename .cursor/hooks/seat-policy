#!/usr/bin/env bash
# Pipeline Cursor seat guardrail hook wrapper.
#
# Fail-closed by design: on any infrastructure fault (missing interpreter,
# missing policy script, unresolvable root) we emit an explicit deny verdict
# and exit 0 -- a clean, self-describing block -- instead of a bare non-zero
# exit. A non-zero exit under `failClosed: true` blocks every agent tool with
# an opaque "exit code 127" and cannot describe itself, which previously caused
# an unrecoverable bootstrap deadlock. Exit 0 with a deny message keeps the
# guardrail fail-closed while remaining diagnosable and self-healing once the
# infrastructure is restored.
set -uo pipefail

deny() {
  printf '{"permission":"deny","user_message":"%s","agent_message":"%s"}\n' "$1" "$1"
  exit 0
}

ROOT=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd) \
  || deny "Cursor seat hook could not resolve the Pipeline root."

PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=$(command -v python3 || true)
[ -n "$PY" ] || deny "Cursor seat hook found no Python interpreter."

POLICY="$ROOT/scripts/cursor_hook_policy.py"
[ -f "$POLICY" ] || deny "Cursor seat hook policy script is missing."

POLICY_OUTPUT=""
if ! POLICY_OUTPUT=$("$PY" "$POLICY" "$@" 2>/dev/null); then
  deny "Cursor seat hook policy failed to execute."
fi
if ! printf '%s' "$POLICY_OUTPUT" | "$PY" -c '
import json
import sys

payload = json.load(sys.stdin)
if not isinstance(payload, dict):
    raise ValueError("hook output must be a JSON object")
' 2>/dev/null; then
  deny "Cursor seat hook policy emitted invalid JSON."
fi

printf '%s\n' "$POLICY_OUTPUT"
