    {
      "id": "ambiguous_effect_outcome_retry",
      "enforcing_phase": 3,
      "expected_invariant": "An ambiguous external effect outcome enters reconciliation-only state and cannot retry or obtain a new effect attempt.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API can describe OUTCOME_UNKNOWN but has no executor, reservation store, or retry gate to block an effect.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "effect.attempt_reserved",
          "facts": {
            "effect_id": "effect:publish-001",
            "executor_id": "executor:primary",
            "idempotency_key": "effect-intent:publish-001",
            "provider": "provider:external-a"
          }
        },
        {
          "step": 2,
          "event_kind": "effect.outcome_unknown",
          "facts": {
            "effect_id": "effect:publish-001",
            "provider": "provider:external-a",
            "outcome": "unknown"
          }
        },
        {
          "step": 3,
          "event_kind": "effect.retry_requested",
          "facts": {
            "effect_id": "effect:publish-001",
            "idempotency_key": "effect-intent:publish-001"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "reconciliation_only",
        "transitions_applied": 2,
        "effect_attempts": 1,
        "provider_attempts": 1
      }
    },
    {
      "id": "duplicate_advisory_dispatch",
      "enforcing_phase": 3,
      "expected_invariant": "An advisory request with an already-reserved intent key cannot dispatch a second provider attempt.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API observes provider lifecycle state but has no advisory dispatcher or reservation ledger.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "advisory.dispatch_requested",
          "facts": {
            "consultation_id": "consultation:duplicate-001",
            "intent_key": "advisory-intent:duplicate-001",
            "provider": "chatgpt",
            "request_digest": "digest:advisory-a"
          }
        },
        {
          "step": 2,
          "event_kind": "advisory.dispatch_requested",
          "facts": {
            "consultation_id": "consultation:duplicate-001",
            "intent_key": "advisory-intent:duplicate-001",
            "provider": "chatgpt",
            "request_digest": "digest:advisory-a"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "idempotent",
        "transitions_applied": 1,
        "effect_attempts": 0,
        "provider_attempts": 1
      }
    },
    {
      "id": "fallback_advisory_dispatch",
      "enforcing_phase": 3,
      "expected_invariant": "A failed, uncertain, or unavailable advisory transport cannot trigger an unreserved provider or transport fallback.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API selects no provider and executes no transport, so only a later guarded dispatcher can enforce this boundary.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "advisory.dispatch_requested",
          "facts": {
            "consultation_id": "consultation:fallback-001",
            "intent_key": "advisory-intent:fallback-001",
            "provider": "chatgpt",
            "transport": "iab"
          }
        },
        {
          "step": 2,
          "event_kind": "advisory.outcome_unknown",
          "facts": {
            "consultation_id": "consultation:fallback-001",
            "intent_key": "advisory-intent:fallback-001",
            "provider": "chatgpt",
            "outcome": "unknown"
          }
        },
        {
          "step": 3,
          "event_kind": "advisory.fallback_requested",
          "facts": {
            "consultation_id": "consultation:fallback-001",
            "intent_key": "advisory-intent:fallback-001",
            "provider": "claude",
            "transport": "api"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "fallback_blocked",
        "transitions_applied": 2,
        "effect_attempts": 0,
        "provider_attempts": 1
      }
    }
  ]
