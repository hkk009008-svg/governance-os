{
  "schema_version": "compact-kernel-misuse-vectors/v1",
  "vectors": [
    {
      "id": "forged_self_asserted_principal",
      "enforcing_phase": 2,
      "expected_invariant": "Actor authority comes from the host-resolved binding, never from payload, prose, role labels, environment, or free CLI arguments.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API observes lifecycle meaning only and receives no actor binding or transition envelope to authenticate.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "transition.requested",
          "facts": {
            "transition_id": "tx-forged-001",
            "host_principal": "principal:director",
            "asserted_principal": "principal:operator",
            "unit_version": 7,
            "payload_digest": "digest:payload-a"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "rejected",
        "transitions_applied": 0,
        "effect_attempts": 0,
        "provider_attempts": 0
      }
    },
    {
      "id": "duplicate_transition_id_identical_payload",
      "enforcing_phase": 2,
      "expected_invariant": "An exact duplicate transition ID and payload is idempotent and produces no second transition.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API is stateless and receives neither a transition ID nor a replay store.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "transition.requested",
          "facts": {
            "transition_id": "tx-identical-001",
            "unit_version": 7,
            "payload_digest": "digest:payload-a"
          }
        },
        {
          "step": 2,
          "event_kind": "transition.requested",
          "facts": {
            "transition_id": "tx-identical-001",
            "unit_version": 7,
            "payload_digest": "digest:payload-a"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "idempotent",
        "transitions_applied": 1,
        "effect_attempts": 0,
        "provider_attempts": 0
      }
    },
    {
      "id": "duplicate_transition_id_changed_payload",
      "enforcing_phase": 2,
      "expected_invariant": "A reused transition ID with changed payload fails closed.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API is stateless and cannot compare current transition content with a prior payload.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "transition.requested",
          "facts": {
            "transition_id": "tx-conflict-001",
            "unit_version": 7,
            "payload_digest": "digest:payload-a"
          }
        },
        {
          "step": 2,
          "event_kind": "transition.requested",
          "facts": {
            "transition_id": "tx-conflict-001",
            "unit_version": 7,
            "payload_digest": "digest:payload-b"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "conflict",
        "transitions_applied": 1,
        "effect_attempts": 0,
        "provider_attempts": 0
      }
    },
    {
      "id": "stale_unit_version",
      "enforcing_phase": 2,
      "expected_invariant": "A transition bound to an older unit version is rejected.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API receives one observed value without current unit identity or version lineage.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "transition.requested",
          "facts": {
            "transition_id": "tx-stale-unit-001",
            "unit_id": "unit:alpha",
            "event_unit_version": 6,
            "current_unit_version": 7
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "rejected",
        "transitions_applied": 0,
        "effect_attempts": 0,
        "provider_attempts": 0
      }
    },
    {
      "id": "stale_activation_epoch",
      "enforcing_phase": 2,
      "expected_invariant": "An event or writer bound to an older activation epoch is inert and rejected.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API has no activation ref, epoch store, or governed writer binding.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "transition.requested",
          "facts": {
            "transition_id": "tx-stale-epoch-001",
            "event_epoch": 0,
            "active_epoch": 1,
            "writer": "compact"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "rejected",
        "transitions_applied": 0,
        "effect_attempts": 0,
        "provider_attempts": 0
      }
    },
    {
      "id": "relevant_dependency_change",
      "enforcing_phase": 2,
      "expected_invariant": "A relevant dependency digest change invalidates the prior verification key.",
      "phase_1_non_enforcement_reason": "The Phase 1 mapping API receives no verification key or dependency digest history.",
      "stimulus": [
        {
          "step": 1,
          "event_kind": "verification.dependency_changed",
          "facts": {
            "unit_id": "unit:alpha",
            "unit_version": 7,
            "verification_key": "verify:alpha-v7",
            "prior_decision": "GO",
            "prior_dependency_digest": "digest:dependency-a",
            "current_dependency_digest": "digest:dependency-b"
          }
        }
      ],
      "expected_future_outcome": {
        "decision": "verification_invalidated",
        "transitions_applied": 1,
        "effect_attempts": 0,
        "provider_attempts": 0
      }
    },
    {
