# Governance OS environment variables
# Copy this file to .env and fill in values for your seat.
# Do NOT add API keys or project-specific secrets here.

# ---------------------------------------------------------------------------
# Core seat identity (set by the harness launcher, not by hand in prod)
# ---------------------------------------------------------------------------

# Seat name for Claude Code sessions: director | director2 | operator | operator2 | coordinator | coordinator2
CLAUDE_SEAT=director

# Seat name for Codex sessions (same value space as CLAUDE_SEAT)
CODEX_SEAT=director

# Per-seat git index path injected by the D-a launcher — prevents index pollution
# across concurrent sessions sharing the same worktree.
# Format: <repo-git-dir>/index-codex-<seat>
GIT_INDEX_FILE=

# ---------------------------------------------------------------------------
# Codex harness runtime contract (all optional — harness infers from CODEX_SEAT)
# ---------------------------------------------------------------------------

# Harness behavior mode: readiness-bridge | live-seat | coordinator | subagent
CODEX_AGENT_MODE=

# Role this instance plays in the four-seat whole
# (director | director2 | operator | operator2 | coordinator | coordinator2 | verifier/specialist)
CODEX_AGENT_ROLE=

# Override canonical live-seat behavior source when identity != behavior seat
CODEX_BEHAVIOR_SOURCE=

# What scope of state this seat may mutate: none | seat-owned | coordination-only | read-only-verification | parent-scoped
CODEX_MUTATION_SCOPE=

# Whether this process can verify, request verification, or only report evidence
CODEX_VERIFICATION_POLICY=

# Side-effect policy — always user-consent-required; override only in tests
CODEX_SIDE_EFFECT_POLICY=user-consent-required

# How git and the shared worktree index should be touched by this seat
CODEX_GIT_POLICY=

# ---------------------------------------------------------------------------
# CI flag (used by ci_smoke.py to suppress interactive output)
# ---------------------------------------------------------------------------

# Set to any non-empty value in CI environments (GitHub Actions sets this automatically)
CI=

# ---------------------------------------------------------------------------
# Threeway ref-bus signing
# ---------------------------------------------------------------------------

# Absolute path to the directory holding per-seat Ed25519 private keys.
# Defaults to ~/.threeway/keys — override when keys live elsewhere.
# KEEP PRIVATE: this directory must not be committed; the value here is the path only.
THREEWAY_KEYSTORE=~/.threeway/keys
